<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NodeKit.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NodeKit.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- U1: TUI 렌더링 -->
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
  </ItemGroup>

  <!-- Sprint R17: GrpcResolveRecipeClient를 위해 gRPC 패키지를 직접 추가. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      GrpcServices=Both: 서버 스텁(BuildServiceBase)도 함께 생성한다. 프로덕션
      경로는 여전히 클라이언트만 사용하지만, NodeKit.Cli.Tests가 in-process
      fake gRPC 서버(TestServer)를 세워 실제 wire-level 테스트를 하려면
      서버 베이스 클래스가 필요하다 — 별도 프로젝트에서 재생성하면 메시지
      타입이 두 어셈블리에 중복 정의되므로, 여기서 한 번에 생성한다.
    -->
    <Protobuf Include="$(ApiProtosRoot)/nodevault/v1/nodevault.proto" GrpcServices="Both" Access="Internal" ProtoRoot="$(ApiProtosRoot)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ProjectReference to ../../NodeKit.csproj 의도적으로 사용 안 함:
      해당 프로젝트는 Avalonia/SkiaSharp/Wasmtime를 참조하며,
      CLI는 gRPC + 검증/직렬화 경로만 필요하다.
      아래 파일들은 모두 System.* 외 의존성이 없는 순수 POCO/로직 코드이므로
      소스 링크로만 가져온다.
    -->
